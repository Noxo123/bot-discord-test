# Token du bot Discord (Discord Developer Portal)
DISCORD_TOKEN=ton_token_discord

# Clé API OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Modèle OpenRouter. openrouter/auto choisit automatiquement un modèle adapté.
OPENROUTER_MODEL=openrouter/auto

# Prompt système facultatif
SYSTEM_PROMPT=Tu es un assistant Discord utile, concis et amical. Réponds en français sauf si on te demande une autre langue.
